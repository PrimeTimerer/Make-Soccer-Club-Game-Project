+/* PS3_USRDIR_OVERLAY=<dir>: a file whose guest path runs through "USRDIR/" is read from <dir>/<rest> when that
+ * is a regular file there, on any device (/dev_bdvd/PS3_GAME/USRDIR/..., /dev_hdd0/game/<ID>/USRDIR/...). A
+ * translation or mod then lives in its own folder and the original files stay as they are; without the
+ * variable nothing changes. Directories are never redirected, so listings still show the original tree.
+ * All three path translators call this first. Sakatsuku: the Korean patch's data files (launcher "한글패치"). */
+int ps3_vfs_usrdir_overlay(const char* guest, char* out, size_t cap)
+{
+    static const char* root = NULL; static int init = 0, log = 0;
+    if (!init) {
+        root = getenv("PS3_USRDIR_OVERLAY");
+        if (root && !*root) root = NULL;
+        const char* e = getenv("PS3_FSLOG");
+        log = e && *e && *e != '0';
+        init = 1;
+    }
+    if (!root || !guest || !out || !cap) return 0;
+    const char* u = strstr(guest, "USRDIR/");
+    if (!u) return 0;
+    char alt[1024];
+    const int n = snprintf(alt, sizeof alt, "%s/%s", root, u + 7);
+    if (n < 0 || (size_t)n >= sizeof alt || (size_t)n + 1 > cap) return 0;
+    fs_normalize_sep(alt);
+    struct stat st;
+    if (stat(alt, &st) != 0 || (st.st_mode & 0xF000) != 0x8000) return 0;
+    memcpy(out, alt, (size_t)n + 1);
+    if (log) fprintf(stderr, "[fs] overlay '%s' -> '%s'\n", guest, out);
+    return 1;
+}
