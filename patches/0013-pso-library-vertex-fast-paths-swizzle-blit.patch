+    n[path]++; p[path] += px;
+    const unsigned long long now = ps3_ms_now();
+    if (!t0) t0 = now;
+    if (now - t0 >= 5000) {
+        fprintf(stderr, "[nv3089] last 5 s: gpu=%u swz=%u/%llukpx row=%u/%llukpx pix=%u/%llukpx\n",
+                n[0], n[1], (unsigned long long)(p[1] / 1000), n[2], (unsigned long long)(p[2] / 1000),
+                n[3], (unsigned long long)(p[3] / 1000));
+        memset(n, 0, sizeof n); memset(p, 0, sizeof p); t0 = now;
+    }
+}
