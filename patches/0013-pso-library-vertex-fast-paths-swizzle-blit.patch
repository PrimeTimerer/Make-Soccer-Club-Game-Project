+/* PSO disk cache (ID3D12PipelineLibrary). The shaders were already cached on
+ * disk, but every pipeline state was still built by the driver on its first
+ * use in each run: 20-60 ms each, a few hundred ms when a new scene brings
+ * several (the match's 300+ ms present spikes). Each PSO is stored under its
+ * key mixed with its two shader blobs, so a different program or compiler
+ * setting can never load a stale one; any mismatch (driver update, other GPU,
+ * different desc) falls back to a normal build. Saved next to the shader cache
+ * every 10 s while new PSOs arrive and at shutdown. LD_NO_PSO_LIBRARY=1 off. */
+static ID3D12PipelineLibrary* g_pso_lib = NULL;
+static void* g_pso_lib_blob = NULL;           /* must outlive the library */
+static int g_pso_lib_state = 0;               /* 0 untried, 1 ready, -1 unavailable */
+static int g_pso_lib_dirty = 0;
+static unsigned g_pso_lib_loaded = 0, g_pso_lib_built = 0;
+static LONGLONG g_pso_lib_saved_qpc = 0;
+
+static void ld_pso_library_path(char* out, size_t cap)
+{
+    snprintf(out, cap, "%s\\pso_library_v1.bin", g_ld_shader_disk_dir);
+}
+
+static void ld_pso_library_init(void)
+{
+    if (g_pso_lib_state) return;
+    g_pso_lib_state = -1;
+    if (getenv("LD_NO_PSO_LIBRARY") || !shader_disk_cache_prepare()) return;
+    ID3D12Device1* dev1 = NULL;
+    if (FAILED(g.dev->lpVtbl->QueryInterface(g.dev, &IID_ID3D12Device1, (void**)&dev1)) || !dev1) return;
+    char path[MAX_PATH];
+    ld_pso_library_path(path, sizeof path);
+    size_t size = 0;
+    FILE* f = fopen(path, "rb");
+    if (f) {
+        fseek(f, 0, SEEK_END); const long n = ftell(f); fseek(f, 0, SEEK_SET);
+        if (n > 0 && (g_pso_lib_blob = malloc((size_t)n)) != NULL &&
+            fread(g_pso_lib_blob, 1, (size_t)n, f) == (size_t)n) size = (size_t)n;
+        fclose(f);
+    }
+    HRESULT hr = E_FAIL;
+    if (size)
+        hr = dev1->lpVtbl->CreatePipelineLibrary(dev1, g_pso_lib_blob, size, &IID_ID3D12PipelineLibrary, (void**)&g_pso_lib);
+    if (FAILED(hr)) {
+        if (size) fprintf(stderr, "[pso-library] '%s' not usable (hr=0x%08lX: driver/GPU changed?) -- starting a new one\n",
+                          path, (unsigned long)hr);
+        free(g_pso_lib_blob); g_pso_lib_blob = NULL; g_pso_lib = NULL;
+        hr = dev1->lpVtbl->CreatePipelineLibrary(dev1, NULL, 0, &IID_ID3D12PipelineLibrary, (void**)&g_pso_lib);
+    }
+    dev1->lpVtbl->Release(dev1);
+    if (FAILED(hr) || !g_pso_lib) {
+        fprintf(stderr, "[pso-library] unavailable (hr=0x%08lX)\n", (unsigned long)hr);
+        g_pso_lib = NULL;
+        return;
+    }
+    g_pso_lib_state = 1;
+    fprintf(stderr, "[pso-library] %s (%zu bytes) from '%s'\n", size ? "loaded" : "new", size, path);
+}
+
+static void ld_pso_library_save(int force)
+{
+    if (g_pso_lib_state != 1 || !g_pso_lib_dirty) return;
+    LARGE_INTEGER now, f; QueryPerformanceCounter(&now); QueryPerformanceFrequency(&f);
+    if (!force && g_pso_lib_saved_qpc && now.QuadPart - g_pso_lib_saved_qpc < 10 * f.QuadPart) return;
+    g_pso_lib_saved_qpc = now.QuadPart;
+    const SIZE_T n = g_pso_lib->lpVtbl->GetSerializedSize(g_pso_lib);
+    void* buf = n ? malloc(n) : NULL;
+    if (!buf) return;
+    if (SUCCEEDED(g_pso_lib->lpVtbl->Serialize(g_pso_lib, buf, n))) {
+        char path[MAX_PATH], tmp[MAX_PATH + 8];
+        ld_pso_library_path(path, sizeof path);
+        snprintf(tmp, sizeof tmp, "%s.tmp", path);
+        FILE* fo = fopen(tmp, "wb");
+        if (fo) {
+            const int ok = fwrite(buf, 1, n, fo) == n;
+            fclose(fo);
+            if (ok && MoveFileExA(tmp, path, MOVEFILE_REPLACE_EXISTING)) {
+                g_pso_lib_dirty = 0;
+                fprintf(stderr, "[pso-library] saved %zu bytes (this run: %u loaded, %u built)\n",
+                        (size_t)n, g_pso_lib_loaded, g_pso_lib_built);
+            }
+        }
+    }
+    free(buf);
+}
