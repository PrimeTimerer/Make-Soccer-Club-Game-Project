+    case 4:  return _mm_cvtsi32_si128((int)rsx_v_rd32(src));
+    case 3:  return _mm_cvtsi32_si128((int)((u32)src[0] | (u32)src[1] << 8 | (u32)src[2] << 16));
+    case 2:  return _mm_cvtsi32_si128((int)rsx_v_rd16(src));
+    case 1:  return _mm_cvtsi32_si128((int)src[0]);
