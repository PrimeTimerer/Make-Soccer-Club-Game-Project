+static inline u16 rsx_v_rd16(const u8* p) { u16 w; memcpy(&w, p, 2); return w; }
+/* The raw bytes of n components of `bytes` each, in the low lanes of a register. */
+static inline __m128i rsx_v_load(const u8* src, u32 total) {
