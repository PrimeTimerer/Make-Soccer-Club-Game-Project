+static inline __m128i rsx_v_bswap32(__m128i v) {
+    v = _mm_shufflelo_epi16(v, 0xB1); v = _mm_shufflehi_epi16(v, 0xB1);
+    return _mm_or_si128(_mm_slli_epi16(v, 8), _mm_srli_epi16(v, 8));
