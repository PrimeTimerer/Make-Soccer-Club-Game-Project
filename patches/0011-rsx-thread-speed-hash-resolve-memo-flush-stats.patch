+/* Per-draw program facts, memoised. Every draw scanned the vertex program for
+ * its END bit, analysed its inputs, scanned it for TXL and hashed it, and
+ * hashed the fragment program: about 10% of the frame-clock thread in a match.
+ * An entry is reused only while the program's bytes are unchanged (memcmp
+ * against a stored copy), so a re-upload or a patched constant is always seen
+ * and every result equals a fresh computation. LD_NO_PROGRAM_MEMO=1 disables. */
+typedef struct {
+    u32 start, instrs, input_mask, txl_mask;
+    u64 hash;
+    u8  bytes[RSX_DSP_VP_INSTR * 16];
+} ld_vp_memo;
+typedef struct {
+    u32 loc, off, size;
+    int buffered;
+    u64 seed, key;
+    u8  bytes[4096];
+} ld_fp_memo;
+#define LD_VP_MEMO_N 16u
+#define LD_FP_MEMO_N 32u
+static ld_vp_memo g_vp_memo[LD_VP_MEMO_N];
+static ld_fp_memo g_fp_memo[LD_FP_MEMO_N];
+static unsigned g_vp_memo_next, g_fp_memo_next;
+unsigned g_ld_memo_stats[4];   /* vp hit, vp miss, fp hit, fp miss ([ld-flush] line) */
+
+static int ld_program_memo_enabled(void)
+{
+    static int on = -1;
+    if (on < 0) on = getenv("LD_NO_PROGRAM_MEMO") ? 0 : 1;
+    return on;
+}
+
+static const ld_vp_memo* ld_vp_facts(u32 start)
+{
+    const u8* vp_uc = (const u8*)(g.rsx.vp + start * 4);
+    const int memo = ld_program_memo_enabled();
+    if (memo)
+        for (unsigned i = 0; i < LD_VP_MEMO_N; i++) {
+            const ld_vp_memo* m = &g_vp_memo[i];
+            if (m->instrs && m->start == start && !memcmp(m->bytes, vp_uc, m->instrs * 16u)) {
+                g_ld_memo_stats[0]++;
+                return m;
+            }
+        }
+    g_ld_memo_stats[1]++;
+    static ld_vp_memo scratch;
+    const u32 instrs = rsx_vp_program_size_instrs(vp_uc, (RSX_DSP_VP_INSTR - start) * 16);
+    if (!instrs) return NULL;
+    ld_vp_memo* m = memo ? &g_vp_memo[g_vp_memo_next++ % LD_VP_MEMO_N] : &scratch;
+    rsx_vp_input_analysis analysis = {0xFFFFu, 0};
+    if (rsx_vp_analyze_inputs(vp_uc, instrs * 16, &analysis) != (int)instrs || !analysis.exact)
+        analysis.input_mask = 0xFFFFu;
+    m->start = start;
+    m->input_mask = analysis.input_mask;
+    m->txl_mask = vp_txl_unit_mask(vp_uc, instrs);
+    m->hash = fnv1a(vp_uc, instrs * 16, 1469598103934665603ull);
+    memcpy(m->bytes, vp_uc, instrs * 16u);
+    m->instrs = instrs;
+    return m;
+}
+
+/* Fragment program size and the PSO key folded from `seed` (the vertex
+ * program's hash), exactly as get_pso computed them. 0 = no END bit. */
+static u32 ld_fp_facts(u32 loc, u32 off, const u8* fp_uc, u64 seed, u64* key_out)
+{
+    const int buffered = ld_fp_constants_buffered();
+    const int memo = ld_program_memo_enabled();
+    if (memo)
+        for (unsigned i = 0; i < LD_FP_MEMO_N; i++) {
+            const ld_fp_memo* m = &g_fp_memo[i];
+            if (m->size && m->loc == loc && m->off == off && m->seed == seed &&
+                m->buffered == buffered && !memcmp(m->bytes, fp_uc, m->size)) {
+                g_ld_memo_stats[2]++;
+                *key_out = m->key;
+                return m->size;
+            }
+        }
+    g_ld_memo_stats[3]++;
+    const u32 size = rsx_fp_program_size(fp_uc, 0x10000);
+    if (!size) return 0;
+    const u64 key = buffered ? rsx_fp_structural_hash(fp_uc, size, seed) : fnv1a(fp_uc, size, seed);
+    if (memo && size <= sizeof g_fp_memo[0].bytes) {
+        ld_fp_memo* m = &g_fp_memo[g_fp_memo_next++ % LD_FP_MEMO_N];
+        m->size = 0;
+        m->loc = loc; m->off = off; m->seed = seed; m->buffered = buffered; m->key = key;
+        memcpy(m->bytes, fp_uc, size);
+        m->size = size;
+    }
+    *key_out = key;
+    return size;
+}
