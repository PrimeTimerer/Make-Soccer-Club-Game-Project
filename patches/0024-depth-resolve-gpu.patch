+              if (rsx_live_draw_depth_resolve_blit(sl, s_nv3089.in_off + v0 * in_pitch + u0 * 4u, in_pitch,
+                                                   s_nv3089.ds_dx, s_nv3089.dt_dy, dl, s_gcm2d.dst_offset,
+                                                   dst_pitch, out_x, out_y, out_w, out_h)) {
+                  nv3089_stat(0, 0);
+                  return;
+              }
