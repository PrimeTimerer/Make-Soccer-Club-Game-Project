+/* Guest addresses of the pages below 0x40000000 written after generation
+ * `since` (as far as harvested; call rsx_ww_harvest_low first). */
+u32 rsx_ww_written_pages_low(u32 since, u32* out, u32 max)
+{
+    if (g_ww_state != 1 || !g_ww_page_gen) return 0;
+    u32 ea[128], n[128];
+    const u32 k = ld_ww_low_regions(ea, n, 128);
+    u32 m = 0;
+    for (u32 i = 0; i < k && m < max; i++)
+        for (u32 pg = ea[i] >> 12; pg < (ea[i] + n[i]) >> 12 && m < max; pg++)
+            if (g_ww_page_gen[pg] > since) out[m++] = pg << 12;
+    return m;
+}
+
+/* Pages below 0x40000000 whose last harvested write has a generation in
