+/* For the match thread's pose interpolation (saka_hooks.c): the write watch
+ * over the guest's committed memory below 0x40000000, sharing the generation
+ * table (so the texture and vertex caches still see every write). */
+static u32 ld_ww_low_regions(u32* ea, u32* n, u32 max)
+{
+    u32 k = 0;
+    u8* p = vm_base + 0x10000u;
+    u8* const end = vm_base + 0x40000000ull;
+    while (p < end && k < max) {
+        MEMORY_BASIC_INFORMATION mi;
+        if (!VirtualQuery(p, &mi, sizeof mi)) break;
+        u8* rb = (u8*)mi.BaseAddress;
+        u8* re = rb + mi.RegionSize;
+        if (re > end) re = end;
+        if (rb < p) rb = p;
+        if (mi.State == MEM_COMMIT) { ea[k] = (u32)(rb - vm_base); n[k] = (u32)(re - rb); k++; }
+        p = re;
+    }
+    return k;
+}
+
+/* Harvests every committed page below 0x40000000; returns the generation
+ * after it (writes from now on get a later one), 0 when unavailable. */
+u32 rsx_ww_harvest_low(void)
+{
+    if (g_ww_state != 1) return 0;
+    u32 ea[128], n[128];
+    const u32 k = ld_ww_low_regions(ea, n, 128);
+    u32 gen = g_ww_gen;
+    for (u32 i = 0; i < k; i++) {
+        const u32 g2 = ld_ww_harvest(vm_base + ea[i], n[i]);
+        if (!g2) return 0;
+        gen = g2;
+    }
+    return gen;
+}
+
+/* Guest addresses of the pages below 0x40000000 written after generation
+ * `since` (as far as harvested; call rsx_ww_harvest_low first). */
+u32 rsx_ww_written_pages_low(u32 since, u32* out, u32 max)
+{
+    if (g_ww_state != 1 || !g_ww_page_gen) return 0;
+    u32 ea[128], n[128];
+    const u32 k = ld_ww_low_regions(ea, n, 128);
+    u32 m = 0;
+    for (u32 i = 0; i < k && m < max; i++)
+        for (u32 pg = ea[i] >> 12; pg < (ea[i] + n[i]) >> 12 && m < max; pg++)
+            if (g_ww_page_gen[pg] > since) out[m++] = pg << 12;
+    return m;
+}
+
+/* Pages below 0x40000000 whose last harvested write has a generation in
+ * (lo, hi]. */
+u32 rsx_ww_written_pages_between(u32 lo, u32 hi, u32* out, u32 max)
+{
+    if (g_ww_state != 1 || !g_ww_page_gen) return 0;
+    u32 ea[128], n[128];
+    const u32 k = ld_ww_low_regions(ea, n, 128);
+    u32 m = 0;
+    for (u32 i = 0; i < k && m < max; i++)
+        for (u32 pg = ea[i] >> 12; pg < (ea[i] + n[i]) >> 12 && m < max; pg++)
+            if (g_ww_page_gen[pg] > lo && g_ww_page_gen[pg] <= hi) out[m++] = pg << 12;
+    return m;
+}
