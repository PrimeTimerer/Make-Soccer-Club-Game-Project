+/* ---- Guest shader compile cache ------------------------------------------
+ * The guest VP/FP paths ran D3DCompile (FXC) synchronously on the present
+ * thread for every cache miss, and an FP pipeline miss -- including one that
+ * differs only in blend/cull/depth state, or an entry the 256-slot FIFO has
+ * evicted -- re-ran the whole compile of an unchanged program. Sakatsuku's
+ * first 3D scene (the secretary) then held the present thread in
+ * D3DCOMPILER_47 for 30+ s (78% of its samples): no vblank ticks, no flips.
+ *
+ * Identical HLSL text compiles to identical bytecode, so the result is
+ * remembered by a 64-bit hash of (target, text): in memory for this run and
+ * on disk for the next (RSX_D3D12_SHADER_CACHE_DIR, default
+ * shader_cache_d3d12\; RSX_D3D12_SHADER_DISK_CACHE=0 keeps it memory-only).
+ * The compiled output is unchanged; only repeated compiles are skipped.
+ * A line "[d3d12-shader]" every 2 s that had compiles reports the counts. */
+#define D3D_SC_VERSION 1u
+#define D3D_SC_SLOTS   8192u
+typedef struct { uint64_t key; uint32_t len; ID3DBlob* blob; } d3d_sc_ent;
+static d3d_sc_ent s_d3d_sc[D3D_SC_SLOTS];
+static unsigned   s_d3d_sc_n;
+static unsigned   s_d3d_sc_compiles, s_d3d_sc_mem_hits, s_d3d_sc_disk_hits, s_d3d_sc_fail;
+static double     s_d3d_sc_ms, s_d3d_sc_report_t;
+
+static uint64_t d3d_sc_hash(const char* target, const char* src, size_t len)
+{
+    uint64_t h = 1469598103934665603ull ^ D3D_SC_VERSION;
+    for (const char* p = target; *p; p++) { h ^= (unsigned char)*p; h *= 1099511628211ull; }
+    h ^= 0xFF; h *= 1099511628211ull;
+    for (size_t i = 0; i < len; i++) { h ^= (unsigned char)src[i]; h *= 1099511628211ull; }
+    return h ? h : 1ull;
+}
+
+static const char* d3d_sc_dir(void)
+{
+    static int s_state = -1; static char s_dir[600];
+    if (s_state < 0) {
+        s_state = 0;
+        const char* off = getenv("RSX_D3D12_SHADER_DISK_CACHE");
+        if (!(off && off[0] == '0')) {
+            const char* d = getenv("RSX_D3D12_SHADER_CACHE_DIR");
+            snprintf(s_dir, sizeof s_dir, "%s", (d && d[0]) ? d : "shader_cache_d3d12");
+            CreateDirectoryA(s_dir, NULL);
+            DWORD a = GetFileAttributesA(s_dir);
+            s_state = (a != INVALID_FILE_ATTRIBUTES && (a & FILE_ATTRIBUTE_DIRECTORY)) ? 1 : 0;
+            fprintf(stderr, "[d3d12-shader] disk cache %s%s\n", s_state ? "at " : "unavailable: ", s_dir);
+        }
+    }
+    return s_state ? s_dir : NULL;
+}
+
+static d3d_sc_ent* d3d_sc_slot(uint64_t key, uint32_t len)
+{
+    unsigned i = (unsigned)(key ^ (key >> 29)) & (D3D_SC_SLOTS - 1u);
+    for (unsigned n = 0; n < D3D_SC_SLOTS; n++, i = (i + 1u) & (D3D_SC_SLOTS - 1u)) {
+        d3d_sc_ent* e = &s_d3d_sc[i];
+        if (!e->blob || (e->key == key && e->len == len)) return e;
+    }
+    return NULL;   /* full */
+}
+
+/* Read <dir>\<key>.dxbc. DXBC carries its own total size at offset 24; a
+ * short or foreign file is ignored and recompiled. */
+static ID3DBlob* d3d_sc_disk_load(uint64_t key, uint32_t len)
+{
+    const char* dir = d3d_sc_dir();
+    if (!dir) return NULL;
+    char path[700];
+    snprintf(path, sizeof path, "%s\\%016llX_%08X.dxbc", dir, (unsigned long long)key, len);
+    FILE* f = fopen(path, "rb");
+    if (!f) return NULL;
+    ID3DBlob* b = NULL;
+    if (fseek(f, 0, SEEK_END) == 0) {
+        long n = ftell(f);
+        if (n >= 32 && n < (64l << 20) && fseek(f, 0, SEEK_SET) == 0 &&
+            SUCCEEDED(D3DCreateBlob((SIZE_T)n, &b)) && b) {
+            unsigned char* p = (unsigned char*)b->lpVtbl->GetBufferPointer(b);
+            if (fread(p, 1, (size_t)n, f) != (size_t)n || memcmp(p, "DXBC", 4) != 0 ||
+                ((uint32_t)p[24] | ((uint32_t)p[25] << 8) | ((uint32_t)p[26] << 16) | ((uint32_t)p[27] << 24)) != (uint32_t)n) {
+                b->lpVtbl->Release(b); b = NULL;
+            }
+        }
+    }
+    fclose(f);
+    return b;
+}
+
+static void d3d_sc_disk_store(uint64_t key, uint32_t len, ID3DBlob* b)
+{
+    const char* dir = d3d_sc_dir();
+    if (!dir || !b) return;
+    char path[700], tmp[720];
+    snprintf(path, sizeof path, "%s\\%016llX_%08X.dxbc", dir, (unsigned long long)key, len);
+    snprintf(tmp, sizeof tmp, "%s.%lu.tmp", path, (unsigned long)GetCurrentThreadId());
+    FILE* f = fopen(tmp, "wb");
+    if (!f) return;
+    const size_t n = b->lpVtbl->GetBufferSize(b);
+    const int ok = fwrite(b->lpVtbl->GetBufferPointer(b), 1, n, f) == n;
+    fclose(f);
+    if (!ok || !MoveFileExA(tmp, path, MOVEFILE_REPLACE_EXISTING)) DeleteFileA(tmp);
+}
+
+/* D3DCompile with the cache in front. Same contract as the call it replaces:
+ * *out gets a reference the caller releases; *err (optional) gets the
+ * compiler's messages on a real compile. */
+static HRESULT d3d_compile_cached(const char* src, size_t len, const char* name,
+                                  const char* target, ID3DBlob** out, ID3DBlob** err)
+{
+    *out = NULL; if (err) *err = NULL;
+    const uint64_t key = d3d_sc_hash(target, src, len);
+    d3d_sc_ent* e = d3d_sc_slot(key, (uint32_t)len);
+    if (e && e->blob) {
+        e->blob->lpVtbl->AddRef(e->blob); *out = e->blob; s_d3d_sc_mem_hits++;
+        return S_OK;
+    }
+    ID3DBlob* b = d3d_sc_disk_load(key, (uint32_t)len);
+    HRESULT hr = S_OK;
+    if (b) s_d3d_sc_disk_hits++;
+    else {
+        const double t0 = perf_now();
+        hr = D3DCompile(src, len, name, NULL, NULL, "main", target, 0, 0, &b, err);
+        s_d3d_sc_ms += (perf_now() - t0) * 1000.0;
+        s_d3d_sc_compiles++;
+        if (FAILED(hr) || !b) { s_d3d_sc_fail++; if (b) { b->lpVtbl->Release(b); b = NULL; } }
+        else d3d_sc_disk_store(key, (uint32_t)len, b);
+    }
+    if (b && e) {   /* remember it: the table holds one reference */
+        e->key = key; e->len = (uint32_t)len; e->blob = b; b->lpVtbl->AddRef(b); s_d3d_sc_n++;
+    }
+    { const double now = perf_now();
+      if (s_d3d_sc_report_t == 0.0) s_d3d_sc_report_t = now;
+      if (now - s_d3d_sc_report_t >= 2.0) {
+          if (s_d3d_sc_compiles || s_d3d_sc_disk_hits || s_d3d_sc_mem_hits > 20)
+              fprintf(stderr, "[d3d12-shader] last %.1fs: %u compiled (%.0f ms, %u failed), %u from disk, %u repeats skipped; %u cached\n",
+                      now - s_d3d_sc_report_t, s_d3d_sc_compiles, s_d3d_sc_ms, s_d3d_sc_fail,
+                      s_d3d_sc_disk_hits, s_d3d_sc_mem_hits, s_d3d_sc_n);
+          s_d3d_sc_compiles = s_d3d_sc_mem_hits = s_d3d_sc_disk_hits = s_d3d_sc_fail = 0;
+          s_d3d_sc_ms = 0.0; s_d3d_sc_report_t = now;
+      } }
+    *out = b;
+    return b ? S_OK : (FAILED(hr) ? hr : E_FAIL);
+}
