+                if (k >= 2 && k <= 4 && (r == 0 || r == 59 || r == 1)) n = k;
+            }
+        }
+    }
+    if (n != cached)
+        fprintf(stderr, "[live-draw] present sync interval %u (display %u Hz)\n", n, hz);
+    cached = n;
+    return cached;
