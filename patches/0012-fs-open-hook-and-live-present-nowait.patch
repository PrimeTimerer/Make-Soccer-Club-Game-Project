 static int g_ld_schedule_diag = 0;
@@ -9639,7 +9642,20 @@ void rsx_live_draw_present(u32 buffer_id)
 
     ld_flush(LD_FLUSH_PRESENT);
     {
-        const HRESULT present_hr = g.swap->lpVtbl->Present(g.swap, 1, 0);
+        /* Fast-forward (rsx_live_draw_set_present_nowait): every frame is still
+         * rendered, but shown at most every ~16 ms and without the vsync wait,
+         * so a frame-locked screen can run many times faster than the display. */
+        static LARGE_INTEGER last_show, show_qf;
+        LARGE_INTEGER show_t; QueryPerformanceCounter(&show_t);
+        if (!show_qf.QuadPart) QueryPerformanceFrequency(&show_qf);
+        const int nowait = g_ld_present_nowait;
+        const int hold = nowait && last_show.QuadPart &&
+                         (show_t.QuadPart - last_show.QuadPart) * 60 < show_qf.QuadPart;
+        HRESULT present_hr = S_OK;
+        if (!hold) {
+            last_show = show_t;
+            present_hr = g.swap->lpVtbl->Present(g.swap, nowait ? 0 : 1, 0);
+        }
         if (SUCCEEDED(present_hr))
             ld_present_measure_record(g_ld_frames + 1u);
         else {
