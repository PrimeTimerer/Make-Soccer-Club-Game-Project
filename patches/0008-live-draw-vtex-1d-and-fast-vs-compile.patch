index eca370f..c7f3a40 100644
--- a/libs/video/rsx_dispatch.c
+++ b/libs/video/rsx_dispatch.c
@@ -596,6 +596,14 @@ void rsx_dsp_get_vertex_texture(const rsx_dispatch* rsx, u32 unit,
     out->width     = rect >> 16;
     out->height    = rect & 0xFFFF;
     out->border_color = rsx_dsp_reg(rsx, base + 0x1C);
+    /* A 1D vertex texture (dimension 1: a skinning palette, one row of
+     * matrices) is a 2D texture one texel high; its height field carries no
+     * row count. Engines that take 2D only would otherwise drop it and skin
+     * nothing (Sakatsuku's match players stood in their bind pose). */
+    if (out->dimension == 1 && !out->cubemap) {
+        out->dimension = 2;
+        out->height = 1;
+    }
 }
 
