                       sp2, cmd & 0xFFu, (unsigned long long)ea, size, lsa);
       } }
 
+    /* PS3_FTRACE: an SPU PUT over the self-JUMP the RSX walker is parked on.
+     * SAKA_PARK_LSDUMP=<file> (with PS3_FTRACE): at the first such PUT, write
+     * that SPU's whole local store to <file> and print its last 64 GETs, which
+     * name the source EA of the job code it is running. */
+    {
+#if defined(_MSC_VER)
+#  define SAKA_DIAG_TLS __declspec(thread)
+#else
+#  define SAKA_DIAG_TLS __thread
+#endif
+      static SAKA_DIAG_TLS uint32_t t_gr[64][4]; static SAKA_DIAG_TLS unsigned t_gn;
+      static const char* s_pdump = (const char*)1;
+      if (s_pdump == (const char*)1) s_pdump = getenv("SAKA_PARK_LSDUMP");
+      if (s_pdump && (cmd & 0xFF) >= 0x40u && (cmd & 0xFF) <= 0x4Fu) {
+          uint32_t* r = t_gr[t_gn++ & 63];
+          r[0] = (uint32_t)ea; r[1] = lsa; r[2] = size; r[3] = cmd & 0xFFu;
+      }
+      const uint32_t pe = g_ps3_ft_park_ea;
+      if (pe && (cmd & 0xFF) >= 0x20u && (cmd & 0xFF) <= 0x2Fu &&
+          (uint32_t)ea <= pe && pe < (uint32_t)ea + size) {
+          const uint64_t t = ps3_ft_now();
+          ps3_ft_span(PS3_FT_PARK_WRITE, 2, spu->spu_id, (uint32_t)ea, t, t);
+          static volatile long s_pdumped = 0;
+          if (s_pdump && InterlockedExchange(&s_pdumped, 1) == 0) {
+              FILE* f = fopen(s_pdump, "wb");
+              if (f) { fwrite(spu->ls, 1, 0x40000, f); fclose(f); }
+              fprintf(stderr, "[park-dump] spu=0x%X pc=0x%05X lr=0x%05X put ea=0x%08X size=%u lsa=0x%05X -> %s\n",
+                      spu->spu_id, (unsigned)(spu->pc & 0x3FFFF), (unsigned)(spu->gpr[0]._u32[0] & 0x3FFFF),
+                      (uint32_t)ea, size, lsa, s_pdump);
+              const unsigned n = t_gn < 64 ? t_gn : 64;
+              for (unsigned i = 0; i < n; i++) {
+                  const uint32_t* g = t_gr[(t_gn - n + i) & 63];
+                  fprintf(stderr, "[park-dump] get#%u cmd=0x%02X ea=0x%08X lsa=0x%05X size=0x%X\n",
+                          i, g[3], g[0], g[1], g[2]);
+              }
+              fflush(stderr);
+          }
+      } }
