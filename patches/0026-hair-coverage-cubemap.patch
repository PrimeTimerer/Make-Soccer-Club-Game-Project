+/* Coverage is evaluated after the ordinary alpha test, before any colour or
+ * depth write. Four physical texels represent one guest 4x-MSAA pixel. */
+static int ld_apply_alpha_coverage(char* hlsl, size_t capacity, u32 samples)
+{
+    if (!samples) return 0;
+    char* marker = NULL;
+    for (char* p = strstr(hlsl, "    return "); p; p = strstr(p + 1, "    return ")) marker = p;
+    if (!marker) return -1;
+    char* expression = marker + strlen("    return ");
+    char* end = strstr(expression, ";\n}\n");
+    if (!end || end == expression || end - expression >= 96) return -1;
+    char value[96];
+    memcpy(value, expression, (size_t)(end - expression)); value[end - expression] = 0;
+    const int mrt = strstr(hlsl, "struct PSOutput") != NULL;
+    const char* threshold = samples >= 4
+        ? "(float(((uint(input.position.x) & 1u) << 1u) ^ (uint(input.position.y) & 1u)) + 0.5) * 0.25"
+        : samples == 2 ? "(float(uint(input.position.x) & 1u) + 0.5) * 0.5" : "0.5";
+    char suffix[768];
+    int n = snprintf(suffix, sizeof suffix,
+        "    %s _rsx_coverage = %s;\n"
+        "    if (!(%s.a >= %s)) discard;\n"
+        "    return _rsx_coverage;\n}\n",
+        mrt ? "PSOutput" : "float4", value,
+        mrt ? "_rsx_coverage.t0" : "_rsx_coverage", threshold);
+    if (n < 0 || (size_t)n >= sizeof suffix || (size_t)(marker - hlsl) + n + 1 > capacity) return -1;
+    memcpy(marker, suffix, (size_t)n + 1);
+    return 1;
+}
