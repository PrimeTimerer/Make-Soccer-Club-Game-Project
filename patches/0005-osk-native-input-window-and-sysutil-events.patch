+static BOOL CALLBACK osk_find_game(HWND h, LPARAM lp)
+{
+    DWORD pid = 0; GetWindowThreadProcessId(h, &pid);
+    if (pid == GetCurrentProcessId() && IsWindowVisible(h) && h != s_osk_hwnd) {
+        *(HWND*)lp = h; return FALSE;
+    }
+    return TRUE;
+}
+
+static ULONGLONG s_osk_t0 = 0;   /* when the input window became usable */
+
+static LRESULT CALLBACK osk_wndproc(HWND h, UINT m, WPARAM w, LPARAM l)
+{
+    switch (m) {
+    case WM_COMMAND:
+        if (LOWORD(w) == IDOK || LOWORD(w) == IDCANCEL) {
+            s_osk_ok = LOWORD(w) == IDOK;
+            if (s_osk_ok && s_osk_edit)
+                GetWindowTextW(s_osk_edit, s_osk_typed, CELL_OSK_MAX_TEXT_LENGTH + 1);
+            printf("[cellOskDialog] %s pressed after %llu ms\n", s_osk_ok ? "OK" : "Cancel",
+                   (unsigned long long)(GetTickCount64() - s_osk_t0));
+            DestroyWindow(h);
+            return 0;
+        }
+        break;
+    case WM_CLOSE:
+        printf("[cellOskDialog] window closed after %llu ms\n",
+               (unsigned long long)(GetTickCount64() - s_osk_t0));
+        s_osk_ok = 0;
+        DestroyWindow(h);
+        return 0;
+    case WM_DESTROY:
+        PostQuitMessage(0);
+        return 0;
+    }
+    return DefWindowProcW(h, m, w, l);
+}
