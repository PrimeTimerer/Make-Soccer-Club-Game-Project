+/* ---------------------------------------------------------------------------
+ * Host text input (Windows)
+ *
+ * The PS3 shows its on-screen keyboard over the game and reports through
+ * sysutil events: LOADED after LoadAsync, FINISHED when the user confirms or
+ * cancels, UNLOADED after UnloadAsync. The stub returned at once and sent
+ * none of them, so a title that waits for FINISHED (Sakatsuku's name entry)
+ * sat on a black screen forever. Here LoadAsync opens a small native window
+ * with an edit box -- Unicode, so the system IME types Japanese or Korean --
+ * on a host thread; FINISHED is queued from the guest's next
+ * cellSysutilCheckCallback once the user presses OK/Enter or Cancel/Esc.
+ * PS3_OSK_TEXT=<text> answers without a window (headless runs).
+ * -----------------------------------------------------------------------*/
+#define CELL_SYSUTIL_OSKDIALOG_LOADED   0x0502
+#define CELL_SYSUTIL_OSKDIALOG_FINISHED 0x0503
+#define CELL_SYSUTIL_OSKDIALOG_UNLOADED 0x0504
+void cellSysutilQueueEvent(int slot, uint32_t status, uint32_t param);   /* cellSysutil.c */
+unsigned long long ps3_qpc_us(void);   /* cellGcmSys.c: log timestamps */
+
+static void osk_broadcast(u32 status)
+{
+    for (int slot = 0; slot < 4 /* CELL_SYSUTIL_MAX_CALLBACKS */; ++slot)
+        cellSysutilQueueEvent(slot, status, 0);
+}
+
+/* 0 idle, 1 window open, 2 answered (FINISHED not yet queued), 3 finished */
+static volatile long s_osk_state = 0;
+static s32 s_osk_result_code = 0;    /* CELL_OSK_DIALOG_INPUT_FIELD_RESULT_* */
 
