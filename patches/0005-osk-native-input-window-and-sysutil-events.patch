+static DWORD WINAPI osk_thread(LPVOID unused)
+{
+    (void)unused;
+    HINSTANCE hi = GetModuleHandleW(NULL);
+    static int registered = 0;
+    if (!registered) {
+        WNDCLASSEXW wc; memset(&wc, 0, sizeof wc);
+        wc.cbSize = sizeof wc; wc.lpfnWndProc = osk_wndproc; wc.hInstance = hi;
+        wc.hCursor = LoadCursor(NULL, IDC_ARROW);
+        wc.hbrBackground = (HBRUSH)(COLOR_BTNFACE + 1);
+        wc.lpszClassName = L"SakaOskDialog";
+        if (!RegisterClassExW(&wc) && GetLastError() != ERROR_CLASS_ALREADY_EXISTS)
+            printf("[cellOskDialog] RegisterClassExW failed (error %lu)\n", GetLastError());
+        registered = 1;
+    }
+    const int W = 620, H = 190;
+    /* Centre on the game window (the D3D12 window class first: the first
+     * visible window of the process can be a minimised console, whose rect
+     * is at -32000), then keep the box inside a monitor's work area. */
+    HWND game = FindWindowA("ps3recomp_d3d12", NULL);
+    if (!game) EnumWindows(osk_find_game, (LPARAM)&game);
+    RECT r = { 0, 0, GetSystemMetrics(SM_CXSCREEN), GetSystemMetrics(SM_CYSCREEN) };
+    if (game && !IsIconic(game)) GetWindowRect(game, &r);
+    POINT c = { (r.left + r.right) / 2, (r.top + r.bottom) / 2 };
+    MONITORINFO mi; memset(&mi, 0, sizeof mi); mi.cbSize = sizeof mi;
+    if (GetMonitorInfoW(MonitorFromPoint(c, MONITOR_DEFAULTTOPRIMARY), &mi)) {
+        if (c.x < mi.rcWork.left + W / 2)   c.x = mi.rcWork.left + W / 2;
+        if (c.x > mi.rcWork.right - W / 2)  c.x = mi.rcWork.right - W / 2;
+        if (c.y < mi.rcWork.top + H / 2)    c.y = mi.rcWork.top + H / 2;
+        if (c.y > mi.rcWork.bottom - H / 2) c.y = mi.rcWork.bottom - H / 2;
+    }
+    const int x = c.x - W / 2, y = c.y - H / 2;
+    s_osk_typed[0] = 0; s_osk_ok = 0;
+    /* caption: U+5165 U+529B (input) */
+    s_osk_hwnd = CreateWindowExW(WS_EX_DLGMODALFRAME | WS_EX_TOPMOST | WS_EX_CONTROLPARENT,
+        L"SakaOskDialog", L"\x5165\x529B (Text input)", WS_CAPTION | WS_SYSMENU | WS_VISIBLE,
+        x, y, W, H, NULL, NULL, hi, NULL);
+    if (!s_osk_hwnd) {   /* no window: answer with the initial text */
+        printf("[cellOskDialog] CreateWindowExW failed (error %lu): answering with the initial text\n",
+               GetLastError());
+        lstrcpynW(s_osk_typed, s_osk_init, CELL_OSK_MAX_TEXT_LENGTH + 1); s_osk_ok = 1;
+    } else {
+        printf("[cellOskDialog] input window at (%d,%d) %dx%d, game window %p t=%.3f\n", x, y, W, H,
+               (void*)game, ps3_qpc_us() / 1e6);
+        HFONT f = CreateFontW(-20, 0, 0, 0, FW_NORMAL, 0, 0, 0, DEFAULT_CHARSET, 0, 0,
+                              CLEARTYPE_QUALITY, 0, L"Meiryo UI");
+        RECT cr; GetClientRect(s_osk_hwnd, &cr);
+        const int cw = cr.right - cr.left;
+        HWND lbl = CreateWindowExW(0, L"STATIC", s_osk_prompt[0] ? s_osk_prompt : L"",
+            WS_CHILD | WS_VISIBLE, 16, 12, cw - 32, 28, s_osk_hwnd, NULL, hi, NULL);
+        s_osk_edit = CreateWindowExW(WS_EX_CLIENTEDGE, L"EDIT", s_osk_init,
+            WS_CHILD | WS_VISIBLE | WS_TABSTOP | ES_AUTOHSCROLL, 16, 46, cw - 32, 34,
+            s_osk_hwnd, (HMENU)(INT_PTR)100, hi, NULL);
+        HWND ok = CreateWindowExW(0, L"BUTTON", L"OK", WS_CHILD | WS_VISIBLE | WS_TABSTOP | BS_DEFPUSHBUTTON,
+            cw - 236, 96, 104, 36, s_osk_hwnd, (HMENU)(INT_PTR)IDOK, hi, NULL);
+        HWND ca = CreateWindowExW(0, L"BUTTON", L"Cancel", WS_CHILD | WS_VISIBLE | WS_TABSTOP,
+            cw - 120, 96, 104, 36, s_osk_hwnd, (HMENU)(INT_PTR)IDCANCEL, hi, NULL);
+        HWND kids[4] = { lbl, s_osk_edit, ok, ca };
+        for (int i = 0; i < 4; i++) if (kids[i] && f) SendMessageW(kids[i], WM_SETFONT, (WPARAM)f, TRUE);
+        SendMessageW(s_osk_edit, EM_SETLIMITTEXT, (WPARAM)s_osk_limit, 0);
+        SendMessageW(s_osk_edit, EM_SETSEL, 0, -1);
+        SetForegroundWindow(s_osk_hwnd);
+        SetFocus(s_osk_edit);
+        s_osk_t0 = GetTickCount64();
+        MSG msg;
+        int keylog = 0;
+        while (GetMessageW(&msg, NULL, 0, 0) > 0) {
+            if (msg.message == WM_KEYDOWN || msg.message == WM_SYSKEYDOWN) {
+                const ULONGLONG dt = GetTickCount64() - s_osk_t0;
+                const int rep = (int)((msg.lParam >> 30) & 1);
+                if (keylog < 24) {
+                    keylog++;
+                    printf("[cellOskDialog] key 0x%02X%s +%llu ms\n", (unsigned)msg.wParam,
+                           rep ? " (repeat)" : "", (unsigned long long)dt);
+                }
+                /* The Enter/Esc that picked the field (still held, or its
+                 * auto-repeat) must not confirm or cancel the empty box the
+                 * moment it opens: only a fresh press after 300 ms counts. */
+                if ((msg.wParam == VK_RETURN || msg.wParam == VK_ESCAPE) && (rep || dt < 300))
+                    continue;
+            }
+            if (!IsDialogMessageW(s_osk_hwnd, &msg)) { TranslateMessage(&msg); DispatchMessageW(&msg); }
+        }
+        if (f) DeleteObject(f);
+        s_osk_hwnd = NULL; s_osk_edit = NULL;
+        if (game && IsWindow(game)) SetForegroundWindow(game);   /* back to the game */
+    }
+    u32 n = 0;
+    if (s_osk_ok)
+        for (; n < CELL_OSK_MAX_TEXT_LENGTH && s_osk_typed[n]; n++) s_result_text[n] = (CellOskDialogChar)s_osk_typed[n];
+    s_result_text[n] = 0;
+    s_result_length = n;
+    s_osk_result_code = s_osk_ok ? CELL_OSK_DIALOG_INPUT_FIELD_RESULT_OK : CELL_OSK_DIALOG_INPUT_FIELD_RESULT_CANCELED;
+    printf("[cellOskDialog] %s (%u chars) t=%.3f\n", s_osk_ok ? "entered" : "cancelled", n,
+           ps3_qpc_us() / 1e6);
+    InterlockedExchange(&s_osk_state, 2);
+    return 0;
+}
+#endif
+
+/* From cellSysutilCheckCallback, on the guest thread: deliver FINISHED once the
+ * host window has an answer. */
+void cellOskDialog_tick(void)
+{
+#ifdef _WIN32
+    if (InterlockedCompareExchange(&s_osk_state, 3, 2) == 2) osk_broadcast(CELL_SYSUTIL_OSKDIALOG_FINISHED);
+#else
+    if (s_osk_state == 2) { s_osk_state = 3; osk_broadcast(CELL_SYSUTIL_OSKDIALOG_FINISHED); }
+#endif
+}
