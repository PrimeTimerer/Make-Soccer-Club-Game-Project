+static WCHAR  s_osk_typed[CELL_OSK_MAX_TEXT_LENGTH + 1];
+static u32    s_osk_limit = CELL_OSK_MAX_TEXT_LENGTH;
+static int    s_osk_ok = 0;
+static HWND   s_osk_hwnd = NULL, s_osk_edit = NULL;
