+/* ---------------------------------------------------------------------------
+ * Texture write watch (LD_TEX_WRITE_WATCH, default on when the host reserved
+ * guest memory with MEM_WRITE_WATCH -- main.cpp alloc_guest_vm).
+ *
+ * A cached texture used to be re-hashed on its first bind every frame: every
+ * byte of every bound texture, ~13% of the frame-clock thread in a match. The
+ * OS keeps a written bit per page (the CPU's dirty bit). At the same moment
+ * the hash ran -- the texture's first bind in a frame -- GetWriteWatch(RESET)
+ * over the texture's pages harvests and clears those bits into a per-page
+ * generation table; the texture is re-hashed only when one of its pages was
+ * written since its last hash. Same decision point as before, so a texture
+ * rewritten between frames is still caught on the bind that uses it.
+ *
+ * Safety net: each texture is still fully hashed every 128 frames (~2 s),
+ * staggered by slot; a change that the write watch missed is refreshed and
+ * logged as [ww-miss]. [ww] prints checks/skips every 5 s.
+ * -----------------------------------------------------------------------*/
+extern u8* vm_base;
+#define LD_WW_PAGES   ((u32)(0x100010000ull >> 12))   /* main.cpp VM_SIZE in 4 KB pages */
+#define LD_WW_CHUNK   16384u                           /* pages per GetWriteWatch call */
+static int  g_ww_state = -1;          /* -1 unprobed, 0 off, 1 on */
+static u32* g_ww_page_gen;            /* per page: generation of its last harvested write */
+static u32  g_ww_gen = 1;             /* bumped by each harvest that found written pages */
+static unsigned long long g_ww_checks, g_ww_skips, g_ww_misses, g_ww_fails;
+
+static int ld_ww_enabled(void)
+{
+    if (g_ww_state >= 0) return g_ww_state;
+    g_ww_state = 0;
+    const char* e = getenv("LD_TEX_WRITE_WATCH");
+    if ((e && *e == '0') || !vm_base) {
+        fprintf(stderr, "[ww] texture write watch: off (%s)\n", vm_base ? "LD_TEX_WRITE_WATCH=0" : "no vm_base");
+        return 0;
+    }
+    /* Probe: GetWriteWatch fails on memory not reserved with MEM_WRITE_WATCH. */
+    static PVOID probe[16]; ULONG_PTR n = 16; DWORD gran = 0;
+    const int ok = GetWriteWatch(0, vm_base + 0x10000u, 16u * 4096u, probe, &n, &gran) == 0;
+    if (ok) g_ww_page_gen = (u32*)calloc(LD_WW_PAGES, sizeof(u32));
+    g_ww_state = ok && g_ww_page_gen ? 1 : 0;
+    fprintf(stderr, "[ww] texture write watch: %s\n",
+            g_ww_state ? "on (re-hash only written textures; LD_TEX_WRITE_WATCH=0 = hash every frame)"
+                       : "off (guest memory not reserved with MEM_WRITE_WATCH)");
+    return g_ww_state;
+}
+
+/* Harvest and reset the written bits of [p, p+n) into g_ww_page_gen. Returns
+ * the generation the harvest left (writes after it show up in a later one),
+ * or 0 when GetWriteWatch failed (the caller then hashes). */
+static u32 ld_ww_harvest(const u8* p, u32 n)
+{
+    static PVOID addrs[LD_WW_CHUNK];
+    if (!n || p < vm_base) return 0;
+    uintptr_t a = (uintptr_t)p & ~(uintptr_t)4095u;
+    const uintptr_t end = ((uintptr_t)p + n + 4095u) & ~(uintptr_t)4095u;
+    if (((end - (uintptr_t)vm_base) >> 12) > LD_WW_PAGES) return 0;
+    int found = 0;
+    while (a < end) {
+        uintptr_t len = end - a;
+        if (len > (uintptr_t)LD_WW_CHUNK * 4096u) len = (uintptr_t)LD_WW_CHUNK * 4096u;
+        ULONG_PTR count = LD_WW_CHUNK; DWORD gran = 0;
+        if (GetWriteWatch(WRITE_WATCH_FLAG_RESET, (PVOID)a, (SIZE_T)len, addrs, &count, &gran) != 0) {
+            g_ww_fails++;
+            return 0;
+        }
+        if (count && !found) { g_ww_gen++; found = 1; }
+        for (ULONG_PTR i = 0; i < count; i++)
+            g_ww_page_gen[((uintptr_t)addrs[i] - (uintptr_t)vm_base) >> 12] = g_ww_gen;
+        a += len;
+    }
+    return g_ww_gen;
+}
+
+/* 1 when no page of [p, p+n) was written since generation `since`. */
+static int ld_ww_clean_since(const u8* p, u32 n, u32 since)
+{
+    const u32 p0 = (u32)(((uintptr_t)p - (uintptr_t)vm_base) >> 12);
+    const u32 p1 = (u32)(((uintptr_t)p + n - 1u - (uintptr_t)vm_base) >> 12);
+    for (u32 i = p0; i <= p1; i++)
+        if (g_ww_page_gen[i] > since) return 0;
+    return 1;
+}
