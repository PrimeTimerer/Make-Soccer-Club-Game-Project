+static void ld_ww_stats(void)
+{
+    static LONGLONG t0, f;
+    LARGE_INTEGER now; QueryPerformanceCounter(&now);
+    if (!f) { LARGE_INTEGER q; QueryPerformanceFrequency(&q); f = q.QuadPart; t0 = now.QuadPart; }
+    if (now.QuadPart - t0 < 5 * f) return;
+    t0 = now.QuadPart;
+    fprintf(stderr, "[ww] last 5 s: texture checks=%llu skipped-hash=%llu misses=%llu fails=%llu\n",
+            g_ww_checks, g_ww_skips, g_ww_misses, g_ww_fails);
+    g_ww_checks = g_ww_skips = 0;
+}
