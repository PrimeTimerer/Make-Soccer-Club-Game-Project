+         * play silence for this period, keep the read index, and publish the
+         * block before it so the producer may write the one we wait for. Bounded,
+         * so a producer that stopped writing does not freeze the port. */
+        if (s_starve_fn && nblock && port->hold_count < 16 &&
+            s_starve_fn((u32)p, (u32)(port->read_index % nblock))) {
