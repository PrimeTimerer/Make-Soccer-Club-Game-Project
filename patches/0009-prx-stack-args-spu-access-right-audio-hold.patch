+/* Endpoint choice. Windows makes a newly connected DualSense/DualShock the
+ * default playback device, so the default endpoint sent the game's sound to
+ * the pad's speaker. PS3_AUDIO_DEVICE=<part of the device name> picks a device
+ * by name (case-insensitive); otherwise game-controller endpoints are skipped
+ * in favour of the first other active one. */
+static const PROPERTYKEY ps3r_PKEY_Device_FriendlyName =
+    { { 0xA45C254E, 0xDF1C, 0x4EFD, { 0x80, 0x20, 0x67, 0xD1, 0x46, 0xA8, 0x50, 0xE0 } }, 14 };
+
+static void audio_device_name(IMMDevice* dev, wchar_t* out, size_t cap)
+{
+    out[0] = 0;
+    IPropertyStore* ps = NULL;
+    if (FAILED(dev->lpVtbl->OpenPropertyStore(dev, STGM_READ, &ps)) || !ps) return;
+    PROPVARIANT pv;
+    PropVariantInit(&pv);
+    if (SUCCEEDED(ps->lpVtbl->GetValue(ps, &ps3r_PKEY_Device_FriendlyName, &pv)) &&
+        pv.vt == VT_LPWSTR && pv.pwszVal)
+        wcsncpy_s(out, cap, pv.pwszVal, _TRUNCATE);
+    PropVariantClear(&pv);
+    ps->lpVtbl->Release(ps);
+}
+
+static int audio_name_has(const wchar_t* name, const wchar_t* needle)
+{
+    if (!needle[0]) return 1;
+    for (; *name; name++) {
+        const wchar_t* a = name; const wchar_t* b = needle;
+        while (*a && *b && towlower(*a) == towlower(*b)) { a++; b++; }
+        if (!*b) return 1;
+    }
+    return 0;
+}
+
+static int audio_is_controller(const wchar_t* n)
+{
+    return audio_name_has(n, L"Wireless Controller") || audio_name_has(n, L"DualSense") ||
+           audio_name_has(n, L"DUALSHOCK");
+}
