+/* SPU_COH_STATS=1: every 5 s, how many writes took the reserved-line path and
+ * the lines they hit most (a 256-entry table, first come first kept), plus how
+ * many lines are marked -- to see whether the cost is a few SPURS control
+ * lines or a whole region (a ring an SPU once reserved and the PPU keeps
+ * writing). Diagnostic only. */
+static void spu_coh_stats_note(uint32_t line)
+{
+    static int on = -1;
+    if (on < 0) on = getenv("SPU_COH_STATS") ? 1 : 0;
+    if (!on) return;
+    static uint32_t key[256], cnt[256]; static unsigned long long total, t0;
+    static unsigned misses;
+    total++;
+    const uint32_t region = line & ~0xFFFFu;   /* 64 KB regions: which structure */
+    uint32_t h = (region >> 16) * 2654435761u >> 24;
+    for (int p = 0; p < 32; p++, h = (h + 1) & 255) {
+        if (key[h] == region) { cnt[h]++; break; }
+        if (!key[h]) { key[h] = region; cnt[h] = 1; break; }
+        if (p == 31) misses++;
+    }
+    extern unsigned long long ps3_ms_now(void);
+    const unsigned long long now = ps3_ms_now();
+    if (!t0) t0 = now;
+    if (now - t0 < 5000) return;
+    unsigned long long marked = 0;
+    for (uint32_t i = 0; i < SPU_COH_BITMAP_SZ; i += 8) {
+        uint64_t w; memcpy(&w, s_coh_bitmap + i, 8);
+        if (w) marked += (unsigned long long)__builtin_popcountll(w);
+    }
+    fprintf(stderr, "[coh] last 5 s: %llu reserved-line writes, %llu lines marked, top:", total, marked);
+    for (int k = 0; k < 10; k++) {
+        int best = -1;
+        for (int i = 0; i < 256; i++) if (key[i] && (best < 0 || cnt[i] > cnt[best])) best = i;
+        if (best < 0 || !cnt[best]) break;
+        fprintf(stderr, " %08X:%u", key[best], cnt[best]);
+        cnt[best] = 0;
+    }
+    fprintf(stderr, " (table misses %u)\n", misses);
+    memset(key, 0, sizeof key); memset(cnt, 0, sizeof cnt); total = 0; misses = 0; t0 = now;
+}
