+static void lwc_wake_all(void)
+{
+    if (lwc_poll_mode()) return;
+    AcquireSRWLockExclusive(&s_lwc_lock);
+    s_lwc_seq++;
+    ReleaseSRWLockExclusive(&s_lwc_lock);
+    WakeAllConditionVariable(&s_lwc_cv);
+}
+static void lwc_wait_1ms(void)
+{
+    if (lwc_poll_mode()) { Sleep(1); return; }
+    AcquireSRWLockExclusive(&s_lwc_lock);
+    if (s_lwc_seq == t_lwc_seen)
+        SleepConditionVariableSRW(&s_lwc_cv, &s_lwc_lock, 1, 0);
+    t_lwc_seen = s_lwc_seq;
+    ReleaseSRWLockExclusive(&s_lwc_lock);
