+/* Returns the entry to draw from, or NULL: then the caller fetches as before
+ * and, when *store is set, hands the result to ld_vc_store. */
+static ld_vc_entry* ld_vc_lookup(const rsx_vertex_layout_plan* layout, u32 prim,
+                                 ld_vc_entry** store, int* verify)
+{
+    LARGE_INTEGER q0, q1;
+    QueryPerformanceCounter(&q0);
+    *store = NULL;
+    *verify = 0;
+    const u32 frame = g_ld_frames;
+    g_vc_lookup_iomap = cellGcm_iomap_generation();
+    rsx_vertex_fetch_plan_init(&dc.fetch_plan, &g.rsx, layout,
+                               (rsx_vertex_guest_ptr_fn)g.guest_ptr, g.guest_user);
+    rsx_dsp_index_array ia;
+    memset(&ia, 0, sizeof ia);
+    const u64 key = ld_vc_key(layout, prim, &ia);
+    ld_vc_age(frame);
+    ld_vc_entry** bucket = &g_vc_bucket[(u32)(key ^ (key >> 32)) & (LD_VC_BUCKETS - 1)];
+    ld_vc_entry* e = *bucket;
+    while (e && e->key != key) e = e->next;
+    ld_vc_entry* hit = NULL;
+    if (!e) {
+        e = (ld_vc_entry*)calloc(1, sizeof *e);
+        if (e) {
+            e->key = key;
+            e->next = *bucket;
+            *bucket = e;
+            e->frame_used = frame;
+            ld_vc_push(&g_vc_keys, e);
+            g_vc_entries++;
+        }
+        g_vcs.miss_new++;
+    } else if (!e->has_data) {
+        ld_vc_unlink(&g_vc_keys, e);
+        e->frame_used = frame;
+        ld_vc_push(&g_vc_keys, e);
+        *store = e;
+        g_vcs.miss_admit++;
+    } else {
+        ld_vc_unlink(&g_vc_data, e);
+        e->frame_used = frame;
+        ld_vc_push(&g_vc_data, e);
+        int ok = e->iomap_gen == g_vc_lookup_iomap;
+        if (!ok) g_vcs.miss_map++;
+        for (u32 i = 0; ok && i < e->n_ranges; i++)
+            if (!ld_ww_harvest(e->ranges[i].p, e->ranges[i].n)) { ok = 0; g_vcs.miss_dirty++; }
+        for (u32 i = 0; ok && i < e->n_ranges; i++)
+            if (!ld_ww_clean_since(e->ranges[i].p, e->ranges[i].n, e->ww_gen)) { ok = 0; g_vcs.miss_dirty++; }
+        if (ok && ((frame + (u32)key) & 127u) == 0 && e->frame_made != frame) {
+            ok = 0;
+            *verify = 1;
+            g_vcs.miss_verify++;
+        }
+        if (ok) {
+            hit = e;
+            g_vcs.hit++;
+            g_vcs.hit_v += e->n_upload;
+        } else
+            *store = e;
+    }
+    QueryPerformanceCounter(&q1);
+    g_vcs.check_qpc += q1.QuadPart - q0.QuadPart;
+    ld_vc_stats();
+    return hit;
+}
