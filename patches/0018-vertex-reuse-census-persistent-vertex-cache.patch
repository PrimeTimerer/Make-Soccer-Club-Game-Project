+/* Index scratch for a group being stored: the upload ring is write-combined
+ * memory, too slow to read back. */
+static u32* ld_vc_ix_reserve(u32 n)
+{
+    if (n > g_vc_ix_cap) {
+        u32 cap = g_vc_ix_cap ? g_vc_ix_cap : 65536u;
+        while (cap < n) cap *= 2u;
+        u32* p = (u32*)realloc(g_vc_ix, (size_t)cap * sizeof(u32));
+        if (!p) return NULL;
+        g_vc_ix = p;
+        g_vc_ix_cap = cap;
+    }
+    return g_vc_ix;
+}
+
+/* After a miss on a known key: keep what was just fetched and indexed (or,
+ * for a scheduled check, compare it with what was kept). */
+static void ld_vc_store(ld_vc_entry* e, int verify, const rsx_vertex_layout_plan* layout,
+                        const void* verts, u32 vb_bytes, int indexed, u32 n_tri,
+                        u32 n_upload, const u32* idx)
+{
+    const u32 frame = g_ld_frames;
+    rsx_dsp_index_array ia;
+    memset(&ia, 0, sizeof ia);
+    if (dc.n_idx) rsx_dsp_get_index_array(&g.rsx, &ia);
+    ld_vc_range r[LD_VC_MAX_RANGES];
+    const u32 nr = ld_vc_ranges(r, layout, &ia);
+    u32 gen = g_ww_gen;
+    int ok = nr != UINT32_MAX;
+    for (u32 i = 0; ok && i < nr; i++) {
+        const u32 g2 = ld_ww_harvest(r[i].p, r[i].n);
+        if (!g2) ok = 0; else gen = g2;
+    }
+    if (!ok) { g_vcs.uncacheable++; ld_vc_drop_data(e); return; }
+    const size_t ib_bytes = indexed ? (size_t)n_tri * sizeof(u32) : 0;
+    if (verify && e->has_data) {
+        g_vcs.verified++;
+        const int same = e->indexed == (u32)indexed && e->n_tri == n_tri &&
+                         e->n_upload == n_upload && e->vb_bytes == vb_bytes &&
+                         (!vb_bytes || !memcmp(e->verts, verts, vb_bytes)) &&
+                         (!ib_bytes || !memcmp(e->idx, idx, ib_bytes));
+        if (same && e->n_ranges == nr && (!nr || !memcmp(e->ranges, r, nr * sizeof *r))) {
+            e->frame_made = frame;
+            e->ww_gen = gen;
+            e->iomap_gen = g_vc_lookup_iomap;
+            return;
+        }
+        if (!same) {
+            g_vcs.vmiss++;
+            static u32 logged;
+            if (logged++ < 32)
+                fprintf(stderr, "[vc-miss] key=%016llX frame=%u verts=%u tri=%u: kept data differed, refreshed\n",
+                        (unsigned long long)e->key, frame, n_upload, n_tri);
+        }
+    }
+    u8* v = vb_bytes ? (u8*)malloc(vb_bytes) : NULL;
+    u32* ix = ib_bytes ? (u32*)malloc(ib_bytes) : NULL;
+    ld_vc_range* rr = nr ? (ld_vc_range*)malloc(nr * sizeof *rr) : NULL;
+    if ((vb_bytes && !v) || (ib_bytes && !ix) || (nr && !rr)) {
+        free(v); free(ix); free(rr);
+        ld_vc_drop_data(e);
+        return;
+    }
+    if (vb_bytes) memcpy(v, verts, vb_bytes);
+    if (ib_bytes) memcpy(ix, idx, ib_bytes);
+    if (nr) memcpy(rr, r, nr * sizeof *rr);
+    ld_vc_drop_data(e);
+    ld_vc_unlink(&g_vc_keys, e);
+    ld_vc_push(&g_vc_data, e);
+    e->has_data = 1;
+    e->verts = v; e->idx = ix; e->ranges = rr; e->n_ranges = nr;
+    e->indexed = (u32)indexed; e->n_tri = n_tri; e->n_upload = n_upload; e->vb_bytes = vb_bytes;
+    e->ww_gen = gen;
+    e->iomap_gen = g_vc_lookup_iomap;
+    e->frame_made = e->frame_used = frame;
+    e->bytes = vb_bytes + ib_bytes + nr * sizeof *rr + sizeof *e;
+    g_vc_bytes += e->bytes;
+    g_vcs.stores++;
+    ld_vc_age(frame);
+}
